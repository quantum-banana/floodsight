{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodsight.local/schemas/live-result.schema.json",
  "title": "FloodSight live result",
  "description": "One provenance-labelled FloodSight observation in normalized coordinates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "incident",
    "frame_id",
    "snapshot_index",
    "snapshot_count",
    "timestamp_ms",
    "source_mode",
    "coordinate_space",
    "data_origin",
    "stream_state",
    "incident_severity",
    "highest_priority_zone_id",
    "system_status",
    "statistics",
    "detections",
    "segmentation",
    "roads",
    "zones",
    "events",
    "route"
  ],
  "properties": {
    "incident_id": { "type": "string", "minLength": 1 },
    "incident": { "$ref": "#/$defs/incidentMetadata" },
    "frame_id": { "type": "integer", "minimum": 0 },
    "snapshot_index": { "type": "integer", "minimum": 0 },
    "snapshot_count": { "type": "integer", "minimum": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "source_mode": { "$ref": "#/$defs/sourceMode" },
    "coordinate_space": { "$ref": "#/$defs/coordinateSpace" },
    "data_origin": { "$ref": "#/$defs/dataOrigin" },
    "stream_state": { "$ref": "#/$defs/streamState" },
    "incident_severity": { "$ref": "#/$defs/severity" },
    "highest_priority_zone_id": { "type": ["string", "null"] },
    "system_status": { "$ref": "#/$defs/systemStatus" },
    "statistics": { "$ref": "#/$defs/statistics" },
    "detections": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
    "segmentation": { "$ref": "#/$defs/segmentation" },
    "roads": { "type": "array", "items": { "$ref": "#/$defs/road" } },
    "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "route": { "oneOf": [{ "$ref": "#/$defs/route" }, { "type": "null" }] },
    "route_alternatives": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "scene_summary": {
      "oneOf": [{ "$ref": "#/$defs/sceneSummary" }, { "type": "null" }]
    },
    "source_dimensions": {
      "oneOf": [{ "$ref": "#/$defs/sourceDimensions" }, { "type": "null" }]
    },
    "evidence_frames": {
      "oneOf": [{ "$ref": "#/$defs/evidenceFrames" }, { "type": "null" }]
    }
  },
  "$defs": {
    "sourceDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "evidenceFrames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentation_source_frame_id",
        "detection_source_frame_id",
        "segmentation_reused",
        "detection_reused"
      ],
      "properties": {
        "segmentation_source_frame_id": { "type": ["integer", "null"], "minimum": 0 },
        "detection_source_frame_id": { "type": ["integer", "null"], "minimum": 0 },
        "segmentation_reused": { "type": "boolean" },
        "detection_reused": { "type": "boolean" }
      }
    },
    "dataOrigin": {
      "type": "string",
      "enum": [
        "REAL_ML_OUTPUT",
        "DERIVED_ANALYTIC",
        "GIS_EXTERNAL_DATA",
        "DEMO_SIMULATED",
        "HUMAN_VERIFIED"
      ]
    },
    "featureProvenance": {
      "type": "string",
      "enum": ["SEGMENTATION", "DETECTION", "DERIVED", "SIMULATED"]
    },
    "sourceMode": {
      "type": "string",
      "enum": ["VIDEO_FILE", "WEBCAM", "DRONE_STREAM", "DEMO_REPLAY", "SIMULATION"]
    },
    "coordinateSpace": {
      "type": "string",
      "enum": ["NORMALIZED_IMAGE", "RELATIVE_TACTICAL"]
    },
    "streamState": {
      "type": "string",
      "enum": ["CONNECTING", "PLAYING", "PAUSED", "COMPLETE"]
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
    },
    "modelState": {
      "type": "string",
      "enum": ["not_configured", "loading", "ready", "unavailable", "error"]
    },
    "inferenceState": {
      "type": "string",
      "enum": [
        "CONNECTING",
        "LIVE",
        "DEGRADED",
        "MODEL_LOADING",
        "MODEL_UNAVAILABLE",
        "SIMULATED_FALLBACK",
        "ERROR"
      ]
    },
    "modelOperationalMode": {
      "type": "string",
      "enum": ["REAL", "FALLBACK", "SIMULATED", "UNAVAILABLE"]
    },
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model", "mode"],
      "properties": {
        "status": { "$ref": "#/$defs/modelState" },
        "model": { "type": ["string", "null"] },
        "mode": { "$ref": "#/$defs/modelOperationalMode" },
        "version": { "type": ["string", "null"] },
        "device": { "type": ["string", "null"] },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "last_successful_inference_ms": { "type": ["integer", "null"], "minimum": 0 },
        "provenance_mode": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }
      }
    },
    "systemStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "segmentation_model", "detection_model"],
      "properties": {
        "api": { "type": "string", "enum": ["operational", "degraded", "offline"] },
        "segmentation_model": { "$ref": "#/$defs/modelState" },
        "detection_model": { "$ref": "#/$defs/modelState" },
        "inference_state": {
          "oneOf": [{ "$ref": "#/$defs/inferenceState" }, { "type": "null" }]
        },
        "segmentation_details": {
          "oneOf": [{ "$ref": "#/$defs/modelStatus" }, { "type": "null" }]
        },
        "detection_details": {
          "oneOf": [{ "$ref": "#/$defs/modelStatus" }, { "type": "null" }]
        }
      }
    },
    "incidentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "title",
        "location_label",
        "started_at_ms",
        "coordinate_space",
        "data_origin"
      ],
      "properties": {
        "incident_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "location_label": { "type": "string", "minLength": 1 },
        "started_at_ms": { "type": "integer", "minimum": 0 },
        "coordinate_space": { "$ref": "#/$defs/coordinateSpace" },
        "data_origin": { "$ref": "#/$defs/dataOrigin" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "confidence", "data_origin"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "enum": ["count", "percent"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" }
      }
    },
    "segmentationMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "width", "height", "data"],
      "properties": {
        "encoding": { "const": "PNG_BASE64" },
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "data": { "type": "string", "minLength": 1 }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flooded_area_percent",
        "people_detected",
        "vehicles_detected",
        "blocked_roads",
        "damaged_buildings"
      ],
      "properties": {
        "flooded_area_percent": { "$ref": "#/$defs/metric" },
        "people_detected": { "$ref": "#/$defs/metric" },
        "vehicles_detected": { "$ref": "#/$defs/metric" },
        "blocked_roads": { "$ref": "#/$defs/metric" },
        "damaged_buildings": { "$ref": "#/$defs/metric" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "boundingBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection_id", "category", "label", "confidence", "bbox", "data_origin"],
      "properties": {
        "detection_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["PERSON", "VEHICLE", "OTHER"] },
        "label": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox": { "$ref": "#/$defs/boundingBox" },
        "data_origin": { "$ref": "#/$defs/dataOrigin" },
        "source_class": { "type": ["string", "null"] },
        "source_class_id": { "type": ["integer", "null"], "minimum": 0 },
        "source_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "detection_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "track_id": { "type": ["string", "null"], "minLength": 1 },
        "track_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "persistence": { "type": ["integer", "null"], "minimum": 1 },
        "observation_state": {
          "type": ["string", "null"],
          "enum": ["DETECTED", "TRACK_PERSISTED", null]
        },
        "source_frame_id": { "type": ["integer", "null"], "minimum": 0 },
        "model_id": { "type": ["string", "null"] },
        "model_provenance": {
          "type": ["string", "null"],
          "enum": ["REAL_MODEL", "PRETRAINED_FALLBACK", "SIMULATED", null]
        }
      }
    },
    "segmentationClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "coverage_percent", "confidence", "data_origin"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" },
        "class_id": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "color": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "type": "integer", "minimum": 0, "maximum": 255 }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "overlayRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlay_id", "kind", "label", "polygon", "confidence", "data_origin"],
      "properties": {
        "overlay_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["FLOOD", "DAMAGED_BUILDING"] },
        "label": { "type": "string", "minLength": 1 },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" }
      }
    },
    "segmentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "classes", "regions"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_configured", "simulated", "processing", "ready", "error"]
        },
        "classes": { "type": "array", "items": { "$ref": "#/$defs/segmentationClass" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/overlayRegion" } },
        "mask": {
          "oneOf": [{ "$ref": "#/$defs/segmentationMask" }, { "type": "null" }]
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "road_id",
        "label",
        "state",
        "access_status",
        "geometry",
        "confidence",
        "data_origin"
      ],
      "properties": {
        "road_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "enum": ["CLEAR", "FLOODED", "BLOCKED", "UNKNOWN"] },
        "access_status": {
          "type": "string",
          "enum": ["ACCESSIBLE", "DEGRADED", "BLOCKED", "ISOLATED", "UNKNOWN"]
        },
        "geometry": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" },
        "travel_cost": { "type": ["number", "null"], "minimum": 0 },
        "enabled": { "type": ["boolean", "null"] },
        "uncertainty": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "zoneReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "description", "contribution", "data_origin"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "contribution": { "type": "number", "minimum": 0, "maximum": 100 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" }
      }
    },
    "zoneAlert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "title",
        "person_evidence",
        "flood_exposure",
        "primary_access",
        "confidence",
        "temporal_samples",
        "reason_codes",
        "data_origin"
      ],
      "properties": {
        "code": { "const": "POTENTIAL_STRANDED_PERSON" },
        "title": { "type": "string", "minLength": 1 },
        "person_evidence": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH"] },
        "flood_exposure": { "type": "string", "enum": ["LOW", "MODERATE", "HIGH"] },
        "primary_access": {
          "type": "string",
          "enum": ["ACCESSIBLE", "DEGRADED", "BLOCKED", "ISOLATED", "UNKNOWN"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "temporal_samples": { "type": "integer", "minimum": 1 },
        "reason_codes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "data_origin": { "$ref": "#/$defs/dataOrigin" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone_id",
        "display_name",
        "rank",
        "severity",
        "priority_score",
        "confidence",
        "polygon",
        "people_count",
        "vehicle_count",
        "flood_coverage_percent",
        "building_damage_count",
        "road_condition",
        "access_status",
        "primary_reason",
        "reasons",
        "updated_at_ms",
        "data_origin"
      ],
      "properties": {
        "zone_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "priority_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point" }
        },
        "people_count": { "type": "integer", "minimum": 0 },
        "vehicle_count": { "type": "integer", "minimum": 0 },
        "flood_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "building_damage_count": { "type": "integer", "minimum": 0 },
        "road_condition": {
          "type": "string",
          "enum": ["CLEAR", "FLOODED", "BLOCKED", "UNKNOWN"]
        },
        "access_status": {
          "type": "string",
          "enum": ["ACCESSIBLE", "DEGRADED", "BLOCKED", "ISOLATED", "UNKNOWN"]
        },
        "primary_reason": { "type": "string", "minLength": 1 },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/zoneReason" } },
        "updated_at_ms": { "type": "integer", "minimum": 0 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" },
        "grid_cells": { "type": "array", "items": { "type": "string" } },
        "building_damage_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "pool_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "temporal_samples": { "type": "integer", "minimum": 1 },
        "stale": { "type": "boolean" },
        "alerts": { "type": "array", "items": { "$ref": "#/$defs/zoneAlert" } }
      }
    },
    "sceneSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water_flood_coverage_percent",
        "pool_coverage_percent",
        "road_clear_coverage_percent",
        "road_flooded_coverage_percent",
        "road_blocked_coverage_percent",
        "building_damage_coverage_percent",
        "provenance",
        "data_origin"
      ],
      "properties": {
        "water_flood_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "pool_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "road_clear_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "road_flooded_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "road_blocked_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "building_damage_coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "provenance": {
          "type": "array",
          "items": { "$ref": "#/$defs/featureProvenance" }
        },
        "data_origin": { "$ref": "#/$defs/dataOrigin" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "timestamp_ms", "severity", "category", "message", "data_origin"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
        "category": {
          "type": "string",
          "enum": ["FLOOD", "DETECTION", "ACCESS", "PRIORITY", "ROUTE", "SYSTEM"]
        },
        "message": { "type": "string", "minLength": 1 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" },
        "code": { "type": ["string", "null"] }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "status",
        "target_zone_id",
        "label",
        "waypoints",
        "distance_m",
        "access_summary",
        "data_origin"
      ],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["RECOMMENDED", "UNAVAILABLE"] },
        "target_zone_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "waypoints": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "distance_m": { "type": ["number", "null"], "minimum": 0 },
        "access_summary": { "type": "string", "minLength": 1 },
        "data_origin": { "$ref": "#/$defs/dataOrigin" },
        "edge_ids": { "type": "array", "items": { "type": "string" } },
        "route_cost": { "type": ["number", "null"], "minimum": 0 },
        "changed_reason": { "type": ["string", "null"] },
        "changed_reason_code": { "type": ["string", "null"] },
        "previous_edge_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
