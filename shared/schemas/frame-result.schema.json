{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodsight.local/schemas/frame-result.schema.json",
  "title": "FloodSight frame result",
  "description": "Acknowledgement for one transient browser-captured JPEG frame.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "session_id",
    "frame_id",
    "accepted",
    "code",
    "message",
    "received_at_ms",
    "processing_ms",
    "byte_length",
    "decoded_frame",
    "quality",
    "data_origin",
    "inference_state",
    "segmentation_status",
    "detection_status"
  ],
  "properties": {
    "type": { "const": "frame_result" },
    "session_id": { "type": "string", "minLength": 1 },
    "frame_id": { "type": ["integer", "null"], "minimum": 0 },
    "accepted": { "type": "boolean" },
    "code": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "received_at_ms": { "type": "integer", "minimum": 0 },
    "processing_ms": { "type": "number", "minimum": 0 },
    "byte_length": { "type": "integer", "minimum": 0 },
    "decoded_frame": {
      "oneOf": [{ "$ref": "#/$defs/decodedFrame" }, { "type": "null" }]
    },
    "quality": {
      "oneOf": [{ "$ref": "#/$defs/quality" }, { "type": "null" }]
    },
    "data_origin": { "const": "DERIVED_ANALYTIC" },
    "inference_state": {
      "oneOf": [{ "$ref": "#/$defs/inferenceState" }, { "type": "null" }]
    },
    "segmentation_status": {
      "oneOf": [{ "$ref": "#/$defs/modelStatus" }, { "type": "null" }]
    },
    "detection_status": {
      "oneOf": [{ "$ref": "#/$defs/modelStatus" }, { "type": "null" }]
    }
  },
  "$defs": {
    "decodedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "channels"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean_luminance",
        "laplacian_variance",
        "brightness_status",
        "sharpness_status",
        "warnings",
        "data_origin"
      ],
      "properties": {
        "mean_luminance": { "type": "number", "minimum": 0, "maximum": 255 },
        "laplacian_variance": { "type": "number", "minimum": 0 },
        "brightness_status": { "type": "string", "enum": ["NORMAL", "DARK", "BRIGHT"] },
        "sharpness_status": { "type": "string", "enum": ["NORMAL", "BLURRY"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "data_origin": { "const": "DERIVED_ANALYTIC" }
      }
    },
    "inferenceState": {
      "type": "string",
      "enum": [
        "CONNECTING",
        "LIVE",
        "DEGRADED",
        "MODEL_LOADING",
        "MODEL_UNAVAILABLE",
        "SIMULATED_FALLBACK",
        "ERROR"
      ]
    },
    "modelStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model",
        "mode",
        "version",
        "device",
        "latency_ms",
        "last_successful_inference_ms",
        "provenance_mode",
        "message"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_configured", "loading", "ready", "unavailable", "error"]
        },
        "model": { "type": ["string", "null"] },
        "mode": { "type": "string", "enum": ["REAL", "FALLBACK", "SIMULATED", "UNAVAILABLE"] },
        "version": { "type": ["string", "null"] },
        "device": { "type": ["string", "null"] },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 },
        "last_successful_inference_ms": { "type": ["integer", "null"], "minimum": 0 },
        "provenance_mode": { "type": ["string", "null"] },
        "message": { "type": ["string", "null"] }
      }
    }
  }
}
