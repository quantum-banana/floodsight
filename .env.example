FLOODSIGHT_ENVIRONMENT=development
FLOODSIGHT_HOST=127.0.0.1
FLOODSIGHT_PORT=8000
FLOODSIGHT_LOG_LEVEL=INFO
FLOODSIGHT_DEMO_STREAM_INTERVAL_MS=1400
FLOODSIGHT_INGEST_CAPTURE_FPS=4
FLOODSIGHT_INGEST_JPEG_QUALITY=0.75
FLOODSIGHT_INGEST_MAX_FRAME_BYTES=2000000
FLOODSIGHT_INGEST_MAX_SESSIONS=24
FLOODSIGHT_INGEST_SESSION_TTL_SECONDS=900
FLOODSIGHT_INGEST_DARK_LUMINANCE_THRESHOLD=35
FLOODSIGHT_INGEST_BRIGHT_LUMINANCE_THRESHOLD=220
FLOODSIGHT_INGEST_BLUR_VARIANCE_THRESHOLD=60
FLOODSIGHT_MODEL_REGISTRY_PATH=configs/models/registry.json
FLOODSIGHT_INFERENCE_DEVICE=auto
FLOODSIGHT_INFERENCE_PRECISION=auto
FLOODSIGHT_INFERENCE_RESOLUTION=768
FLOODSIGHT_INFERENCE_FRAME_STRIDE=1
FLOODSIGHT_SEGMENTATION_CADENCE=1
FLOODSIGHT_DETECTION_CADENCE=1
FLOODSIGHT_DETECTION_CONFIDENCE_THRESHOLD=0.25
FLOODSIGHT_DETECTION_IOU_THRESHOLD=0.7
FLOODSIGHT_DETECTION_STANDARD_RESOLUTION=640
FLOODSIGHT_DETECTION_AERIAL_RESOLUTION=1280
FLOODSIGHT_DETECTION_AERIAL_TILE_OVERLAP=0.2
FLOODSIGHT_DETECTION_AERIAL_FUSION_IOU_THRESHOLD=0.5
FLOODSIGHT_DETECTION_AERIAL_HIGH_RECALL_RESOLUTION=1280
FLOODSIGHT_DETECTION_AERIAL_HIGH_RECALL_TILE_OVERLAP=0.25
FLOODSIGHT_DETECTION_AERIAL_HIGH_RECALL_PERSON_CONFIDENCE=0.5
FLOODSIGHT_DETECTION_SEGFORMER_REINSPECTION_ENABLED=true
FLOODSIGHT_DETECTION_SEGFORMER_REINSPECTION_PADDING=0.75
FLOODSIGHT_DETECTION_SEGFORMER_REINSPECTION_MIN_PIXELS=24
FLOODSIGHT_TEMPORAL_WINDOW_MS=1500
FLOODSIGHT_TEMPORAL_TRACK_TTL_MS=2000
FLOODSIGHT_URGENT_PERSON_CONFIDENCE=0.85
FLOODSIGHT_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Model artifacts remain outside Git. Missing paths are reported as MODEL_UNAVAILABLE.
FLOODSIGHT_SEGMENTATION_CHECKPOINT=
FLOODSIGHT_DETECTION_CHECKPOINT=
FLOODSIGHT_DETECTION_FALLBACK_CHECKPOINT=

# Phase 3 external data paths. Keep datasets outside this repository.
# Windows example: D:\FloodSight-Datasets and D:\FloodSight-Cache
# Linux example: /data/floodsight-datasets and /data/floodsight-cache
FLOODSIGHT_DATA_ROOT=
FLOODSIGHT_DATA_CACHE=
